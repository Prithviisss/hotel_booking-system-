# ==============================================================================
# HOTEL RESERVATION SYSTEM - ENVIRONMENT CONFIGURATION (TEAM-6)
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Leave empty to automatically use the built-in zero-config in-memory MongoDB server
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotel_db?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token Secret & Expiration
JWT_SECRET=grand_heritage_luxury_jwt_secret_team6_2026
JWT_EXPIRE=30d

# Razorpay Test Mode Credentials
# Enter your Razorpay Test API keys from https://dashboard.razorpay.com/app/keys
# If left empty or placeholder, the backend automatically enables the full Mock Payment Mode
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder

